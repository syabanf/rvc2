# Caddy site block for the RVC PWA (static export in out/).
# Upload out/ to /var/www/rvc2 (or change root), add this block, then `caddy reload`.
rvc2.reddie.id {
	root * /var/www/rvc2
	encode zstd gzip

	# Hashed build output never changes; the service worker must always revalidate.
	header /_next/static/* Cache-Control "public, max-age=31536000, immutable"
	header /sw.js Cache-Control "no-cache"

	try_files {path} {path}/index.html
	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
